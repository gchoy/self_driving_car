local Car = require "scripts.car"
local Controls = require "scripts.controls"
local Sensor = require "scripts.sensors"
local TrafficManager = require "scripts.traffic_manager"


local function draw_polygon(polygon)

	for i = 1, #polygon do

		local next_i =
		(i % #polygon) + 1

		local a = polygon[i]
		local b = polygon[next_i]

		msg.post(
		"@render:",
		"draw_line",
		{
			start_point =
			vmath.vector3(
			a.x,
			a.y,
			0
		),

		end_point =
		vmath.vector3(
		b.x,
		b.y,
		0
	),

	color =
	vmath.vector4(1, 0, 0, 1)
}
)
end
end

function init(self)
	msg.post(".", "acquire_input_focus")

	print("CAR SCRIPT INITIALIZED")
	
	local position = go.get_position()
	--local CONTROL_MODE = "KEYS"
	local CONTROL_MODE = "AI"
	
	
	
	self.car = Car.new(
	300,
	100,
	30,
	50,
	CONTROL_MODE,
	3
	) 
	print("AI MODE:", self.car.use_brain)
	print("BRAIN EXISTS:", 	self.car.brain ~= nil)
	print("BRAIN LEVELS:", #self.car.brain.levels)
	print("BRAIN INPUTS:", #self.car.brain.levels[1].inputs)
	print("BRAIN OUTPUTS:", #self.car.brain.levels[1].outputs)

	self.debug = true
	self.car.polygon = Car.create_polygon(self.car)

	print("CAR INITIALIZED")
	print("CAR POLYGON CREATED")

	print("SENSOR CREATED")

	print("RAY COUNT:", self.car.sensor.ray_count)

	print("RAY LENGTH:", self.car.sensor.ray_length)

	print("RAY SPREAD:", self.car.sensor.ray_spread)
	
end



function update(self, dt)

	--------------------------------------------------
	-- 1. Get traffic
	--------------------------------------------------

	local traffic =
	TrafficManager.get_all()

	--------------------------------------------------
	-- 2. Update the car simulation
	--------------------------------------------------

	Car.update(
	self.car,
	self.road_borders,
	traffic
	)

	print("TRAFFIC COUNT:", #traffic)



	local ray = self.car.sensor.rays[3]

	print(
	"CENTER RAY:",
	"START",
	ray[1].x,
	ray[1].y,
	"END",
	ray[2].x,
	ray[2].y
	)

--------------------------------------------------
-- 3. Visualize sensors
--------------------------------------------------

if self.debug then
Sensor.draw(self.car.sensor)
end


--------------------------------------------------
-- 4. Print sensor readings
--------------------------------------------------
for i = 1, self.car.sensor.ray_count do

	local reading = self.car.sensor.readings[i]

	if reading then
		print(
		"SENSOR",
		i,
		"DETECTED",
		"X:",
		reading.x,
		"Y:",
		reading.y,
		"OFFSET:",
		reading.offset
	)
else
	print(
	"SENSOR",
	i,
	"NO DETECTION"
)
end

end




--------------------------------------------------
-- 5. Draw player polygon
--------------------------------------------------

if self.debug then
draw_polygon(self.car.polygon)
end


--------------------------------------------------
-- 6. Update player visual
--------------------------------------------------

go.set_position(
vmath.vector3(
self.car.x,
self.car.y,
0
)
)

go.set_rotation(
vmath.quat_rotation_z(
-self.car.angle
)
)

end

function on_message(self, message_id, message, sender)

	if message_id == hash("set_road") then

		self.road_borders = {
			{
				vmath.vector3(
				message.left,
				-1000,
				0
			),

			vmath.vector3(
			message.left,
			1000,
			0
		)
	},

	{
		vmath.vector3(
		message.right,
		-1000,
		0
	),

	vmath.vector3(
	message.right,
	1000,
	0
)
}
}

print("ROAD BORDERS RECEIVED")


end


	
end

function on_input(self, action_id, action)
	
		

		if action.pressed then
			
			Controls.apply_input(
			self.car.controls,
			action_id,
			action
			)

		end

		if action.released then
			

			Controls.release_input(
			self.car.controls,
			action_id
			)

			
		end 

		
	
end


